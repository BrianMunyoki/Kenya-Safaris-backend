# Copy this file to .env and fill in your real values. Never commit .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True

# MySQL
DB_NAME=kenya_safaris
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Frontend origin(s) allowed to call this API (comma-separated, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://kenyasavannah.com
